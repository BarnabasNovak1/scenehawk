# ─── LLM provider ────────────────────────────────────────────────
# Leave unset to run with the built-in heuristic/mock providers.
# The full app works without a key — interpretation falls back to a
# lexicon-based heuristic and explanations are template-generated.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Retrieval backend ──────────────────────────────────────────
# lexical   = local BM25 over analytical chunks (default, zero deps)
# embedding = OpenAI embeddings + cosine similarity (needs API key)
RETRIEVER=lexical

# ─── Film store ─────────────────────────────────────────────────
# local    = JSON files in data/films/ (default)
# firebase = Firestore adapter (fill in below + implement stub)
FILM_STORE=local

# ─── Firebase / Firestore (when you switch FILM_STORE=firebase) ─
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or point at a service account JSON:
GOOGLE_APPLICATION_CREDENTIALS=
